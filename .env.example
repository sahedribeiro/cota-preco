# Executar comandos a partir da raiz do projecto.
DATABASE_URL=sqlite:///./data/cota-preco-ai.db
UPLOAD_PATH=./data/uploads
PRICE_SEARCH_CACHE_HOURS=24
# Usado pelo chat e pela extracção de documentos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_TIMEOUT_SECONDS=40
# Perfil PostgreSQL opcional, apenas para desenvolvimento local.
POSTGRES_DB=cota_preco_ai
POSTGRES_USER=kota
POSTGRES_PASSWORD=local-development-only

UPLOAD_MAX_SIZE_MB=10
DOCUMENT_MAX_CHARS=8000

CATALOG_STALE_DAYS=60
AUTH_ENABLED=true
# Em produção com HTTPS, definir true.
AUTH_COOKIE_SECURE=false
